    "feature_transform_summary": {
      "Step: extract_regex": {
        "reasoning": "The trailing side letter (P/S) of Cabin is a meaningful, low-cardinality spatial feature with known predictive value on this dataset and is cheap to derive from the existing string.",
        "params": {
          "column": "Cabin",
          "pattern": "/([A-Za-z])$",
          "new_col": "CabinSide"
        }
      },
      "Step: create_binning": {
        "reasoning": "Age has 80 distinct values and possible nonlinear/segmented effects (children vs adults vs seniors); quantile binning yields a compact AgeBin feature alongside the continuous Age.",
        "params": {
          "column": "Age",
          "n_bins": 5,
          "new_col": "AgeBin",
          "strategy": "quantile"
        }
      },
      "Step: create_interaction": {
        "reasoning": "Spa and VRDeck are the two correlated wellness-related spending columns (r≈0.16 in EDA) and share high outlier rates; a summed WellnessSpend provides a stable combined signal while reducing per-feature sparsity/noise.",
        "params": {
          "cols": [
            "Spa",
            "VRDeck"
          ],
          "operator": "+",
          "new_col": "WellnessSpend"
        }
      },
      "Step: encode_categorical": {
        "reasoning": "HomePlanet has 3 categories with a clearly different Transported rate (Earth ≈57% False vs Europa ≈66% True), so one-hot encoding makes this strong, non-ordinal categorical signal directly usable by downstream models.",
        "params": {
          "column": "HomePlanet",
          "method": "onehot"
        }
      }
    },
