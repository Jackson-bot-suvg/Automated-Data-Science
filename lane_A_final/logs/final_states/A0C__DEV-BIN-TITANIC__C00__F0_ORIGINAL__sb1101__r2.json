      "Step: extract_regex": {
        "reasoning": "Extract passenger title from Name, a standard Titanic feature that captures social status and demographic information without using protected columns.",
        "params": {
          "column": "Name",
          "pattern": "([A-Za-z]+)\\.",
          "new_col": "Title"
        }
      },
      "Step: create_interaction": {
        "reasoning": "Combine sibling/spouse and parent/child counts into a single family-size feature, useful because both are numeric and family context affects survival.",
        "params": {
          "cols": [
            "SibSp",
            "Parch"
          ],
          "operator": "+",
          "new_col": "FamilySize"
        }
      },
      "Step: create_binning": {
        "reasoning": "Bin the numeric Age variable into quantile groups to capture nonlinear age effects while remaining safe for tree and linear downstream models.",
        "params": {
          "column": "Age",
          "n_bins": 5,
          "new_col": "AgeBin",
          "strategy": "quantile"
        }
      },
      "Step: group_rare_categories": {
        "reasoning": "Cabin has many sparse category levels; grouping rare categories reduces high-cardinality noise before any optional encoding.",
        "params": {
          "column": "Cabin",
          "threshold": 0.03,
          "rare_label": "Other"
        }
      },
      "Step: encode_categorical": {
        "reasoning": "Encode the low-cardinality Sex categorical feature into numeric indicator form, which is safe and directly usable by downstream models.",
        "params": {
          "column": "Sex",
          "method": "onehot"
        }
